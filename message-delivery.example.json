{
  "Host": "",
  "Port": "8090",
  "Broker": {
    "Host": "127.0.0.1:5673",
    "User": "guest",
    "Password": "",
    "PasswordEnv": "RABBITMQ_PASSWORD",
    "ExchangeName": "messages.events",
    "ExchangeKind": "topic",
    "ConsumeQueue": "message.delivery.requests",
    "PrefetchCount": 8,
    "RoutingKeys": {
      "DeliveryRequested": "message.delivery.requested",
      "DeliveryResult": "message.delivery.result",
      "TelegramConnectionRequested": "notification.telegram.connection.requested"
    }
  },
  "Providers": {
    "Email": {
      "Enabled": true,
      "DefaultProvider": "fake-email",
      "AllowedProviders": ["fake-email", "smtp"],
      "Adapters": {
        "fake-email": {
          "Enabled": true,
          "Kind": "fake",
          "Status": "sent"
        },
        "smtp": {
          "Enabled": false,
          "Kind": "smtp",
          "Host": "smtp.example.com",
          "Port": 587,
          "Security": "starttls",
          "AuthHost": "smtp.example.com",
          "TimeoutSec": 15,
          "UsernameEnv": "SMTP_USERNAME",
          "PasswordEnv": "SMTP_PASSWORD",
          "From": "no-reply@example.com"
        }
      }
    },
    "Phone": {
      "DefaultProviderChain": ["telegram", "sms"],
      "AllowedProviders": ["telegram", "sms"],
      "Adapters": {
        "telegram": {
          "Enabled": true,
          "Kind": "fake",
          "Status": "undeliverable",
          "BaseURL": "https://gatewayapi.telegram.org",
          "TimeoutSec": 10,
          "ApiTokenEnv": "TELEGRAM_GATEWAY_API_TOKEN"
        },
        "sms": {
          "Enabled": true,
          "Kind": "fake",
          "Status": "sent"
        }
      }
    },
    "Push": {
      "Enabled": false,
      "DefaultProvider": "webpush",
      "AllowedProviders": ["webpush"],
      "Adapters": {
        "webpush": {
          "Enabled": false,
          "Kind": "webpush",
          "TimeoutSec": 10,
          "VAPIDPublicKeyEnv": "MESSAGE_DELIVERY_WEB_PUSH_VAPID_PUBLIC_KEY",
          "VAPIDPrivateKeyEnv": "MESSAGE_DELIVERY_WEB_PUSH_VAPID_PRIVATE_KEY",
          "VAPIDSubscriber": "mailto:notifications@example.com"
        }
      }
    },
    "Telegram": {
      "Enabled": false,
      "DefaultProvider": "telegram-bot",
      "AllowedProviders": ["telegram-bot"],
      "Adapters": {
        "telegram-bot": {
          "Enabled": false,
          "Kind": "telegram-bot",
          "BaseURL": "https://api.telegram.org",
          "TimeoutSec": 10,
          "BotTokenEnv": "MESSAGE_DELIVERY_TELEGRAM_BOT_TOKEN",
          "PublicBaseURL": "https://app.example.com"
        }
      }
    }
  },
  "TelegramBot": {
    "Enabled": false,
    "WebhookPath": "/bot/webhook",
    "WebhookSecretEnv": "MESSAGE_DELIVERY_TELEGRAM_WEBHOOK_SECRET",
    "ConnectionRoutingKey": "notification.telegram.connection.requested",
    "MaxBodyBytes": 1048576,
    "PublishTimeoutSec": 5,
    "Presentation": {
      "WelcomeTitle": {
        "en": "Telegram notifications connected",
        "ru": "Telegram-уведомления подключены"
      },
      "WelcomeBody": {
        "en": "We will send important updates here. You can change notification settings in the app at any time.",
        "ru": "Сюда будут приходить важные обновления. Настройки уведомлений можно изменить в приложении в любое время."
      },
      "NotificationFallbackTitle": {
        "en": "New notification",
        "ru": "Новое уведомление"
      },
      "NotificationFooter": {
        "en": "Notification delivery",
        "ru": "Уведомления"
      },
      "OpenActionLabel": {
        "en": "Open in app",
        "ru": "Открыть в приложении"
      }
    }
  },
  "Templates": {
    "DefaultLocale": "en",
    "BaseDir": "templates",
    "Items": {
      "auth_verification_code": {
        "Subject": {
          "en": "Verification code",
          "ru": "Код подтверждения"
        },
        "TextBody": {
          "en": "Your code is {{code}}. It expires in {{ttl_sec}} seconds.",
          "ru": "Ваш код: {{code}}. Он действует {{ttl_sec}} секунд."
        },
        "HtmlBodyFile": {
          "en": "email/auth_verification_code.en.html",
          "ru": "email/auth_verification_code.ru.html"
        },
        "RequiredVariables": ["code", "ttl_sec"]
      },
      "auth_password_reset": {
        "Subject": {
          "en": "Password reset code",
          "ru": "Код сброса пароля"
        },
        "TextBody": {
          "en": "Your password reset code is {{code}}. It expires in {{ttl_sec}} seconds.",
          "ru": "Ваш код сброса пароля: {{code}}. Он действует {{ttl_sec}} секунд."
        },
        "HtmlBodyFile": {
          "en": "email/auth_password_reset.en.html",
          "ru": "email/auth_password_reset.ru.html"
        },
        "RequiredVariables": ["code", "ttl_sec"]
      },
      "chat_message_notification": {
        "Subject": {
          "en": "New message from {{sender}}",
          "ru": "Новое сообщение от {{sender}}"
        },
        "TextBody": {
          "en": "{{message}}",
          "ru": "{{message}}"
        },
        "HtmlBodyFile": {
          "en": "email/chat_message_notification.en.html",
          "ru": "email/chat_message_notification.ru.html"
        },
        "RequiredVariables": ["sender", "message", "chat_id"]
      },
      "notification": {
        "Subject": {
          "en": "New notification",
          "ru": "Новое уведомление"
        },
        "TextBody": {
          "en": "Open the application to view the notification.",
          "ru": "Откройте приложение, чтобы посмотреть уведомление."
        }
      }
    }
  }
}
